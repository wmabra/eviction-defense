# App
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./eviction_defense.db

# Authorize.net
# Sandbox mode (test with fake cards — no real charges):
AUTHORIZE_LOGIN_ID=
AUTHORIZE_TRANSACTION_KEY=
AUTHORIZE_SANDBOX=true
# When going live, paste live keys above and set AUTHORIZE_SANDBOX=false

# LLM Provider (for AI document extraction)
# DeepSeek (cheap, ~$0.14/M tokens):
#   LLM_API_KEY=sk-your-deepseek-key
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
# OpenAI (more expensive, ~$0.15-10/M tokens):
#   LLM_API_KEY=sk-your-openai-key
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#
# Leave empty to use the free regex fallback (no AI needed)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Google Cloud (Document AI — optional, for better OCR)
GOOGLE_APPLICATION_CREDENTIALS=

# Twilio (for SMS reminders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15551234567

# SendGrid (for email delivery)
SENDGRID_API_KEY=

# App URLs
APP_URL=https://evictions.help

# Retell AI (voice support agent)
